# Copie para .env.local. O modo rules não usa um provedor de IA.
SENSO_INTERPRETER=rules

# Para habilitar perguntas mais livres, altere acima para openai e preencha a chave.
# A chave pertence ao servidor: nunca use prefixo NEXT_PUBLIC_ nem faça commit dela.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
