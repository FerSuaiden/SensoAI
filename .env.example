# Copie para .env.local. Modos: gemini (padrão), openai ou rules (sem IA).
SENSO_INTERPRETER=gemini

# Crie a chave em https://aistudio.google.com/apikey e preencha somente em .env.local.
# Credenciais são do servidor: nunca use NEXT_PUBLIC_ nem faça commit delas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Alternativa: altere SENSO_INTERPRETER para openai e preencha a chave abaixo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
